<Window x:Class="ApexAI.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexAI Settings" Width="440" Height="330" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#FF17212B">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Engineer settings" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <TextBlock Grid.Row="1" Text="Provider" Foreground="#FFB8C5D6"/>
    <ComboBox x:Name="ProviderBox" Grid.Row="2" Margin="0,4,0,8" Padding="5">
      <ComboBoxItem Content="Offline"/>
      <ComboBoxItem Content="OpenAI-compatible"/>
    </ComboBox>
    <TextBlock Grid.Row="3" Text="Endpoint" Foreground="#FFB8C5D6"/>
    <TextBox x:Name="EndpointBox" Grid.Row="4" Margin="0,4,0,8" Padding="5"/>
    <StackPanel Grid.Row="5">
      <TextBlock Text="Model / API key (key is stored with Windows DPAPI)" Foreground="#FFB8C5D6"/>
      <TextBox x:Name="ModelBox" Margin="0,4,0,8" Padding="5"/>
      <PasswordBox x:Name="ApiKeyBox" Padding="5"/>
      <TextBlock Text="ACC UDP port" Foreground="#FFB8C5D6" Margin="0,8,0,0"/>
      <TextBox x:Name="PortBox" Margin="0,4,0,0" Padding="5"/>
    </StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" IsCancel="True" Padding="12,5" Margin="0,0,8,0"/>
      <Button Content="Save" IsDefault="True" Padding="12,5" Click="SaveClick"/>
    </StackPanel>
  </Grid>
</Window>
