<Window x:Class="ApexAI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexAI Race Engineer" Width="420" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True">
  <Border Background="#E8171B24" BorderBrush="#FF4DD0E1" BorderThickness="1" CornerRadius="12" Padding="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <TextBlock Text="APEXAI" Foreground="#FF4DD0E1" FontWeight="Bold" FontSize="16"/>
        <TextBlock x:Name="ConnectionText" DockPanel.Dock="Right" Text="STARTING" Foreground="#FFFFB74D" FontSize="11"/>
      </DockPanel>
      <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,12,0,8" Text="Waiting for telemetry..." Foreground="White" FontSize="18" FontWeight="SemiBold"/>
      <StackPanel Grid.Row="2">
        <TextBlock x:Name="RaceText" Foreground="#FFB8C5D6" FontFamily="Consolas"/>
        <TextBlock x:Name="EngineerText" Margin="0,8,0,0" Foreground="#FFFFD180" TextWrapping="Wrap"/>
      </StackPanel>
      <DockPanel Grid.Row="3" Margin="0,12,0,0">
        <TextBlock x:Name="ModeText" Foreground="#FF8FA3B8" FontSize="11" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Right" Content="Settings" Padding="8,2" Margin="0,0,6,0" Click="SettingsClick"/>
        <Button DockPanel.Dock="Right" Content="Close" Padding="8,2" Click="CloseClick"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
