<Window x:Class="ApexAI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexAI Race Engineer" Width="680" Height="460"
        MinWidth="520" MinHeight="360" MaxWidth="1100" MaxHeight="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" Opacity="0.94">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="CardText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFF4F5F7"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#FFF4F5F7"/>
      <Setter Property="Background" Value="#FF262A34"/>
      <Setter Property="BorderBrush" Value="#FF3A3E4A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Border CornerRadius="18" BorderThickness="1" BorderBrush="#FF5B2029" Padding="22">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F20C0D12" Offset="0"/>
        <GradientStop Color="#F2181A22" Offset="0.62"/>
        <GradientStop Color="#F23A1018" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="HeaderPanel" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
          <Border Background="#FFE52B3A" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
            <TextBlock Text="AI" Foreground="White" FontSize="12" FontWeight="Bold"/>
          </Border>
          <StackPanel Margin="11,0,0,0">
            <TextBlock Text="APEXAI" Foreground="White" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="RACE ENGINEER  /  LIVE TELEMETRY" Foreground="#FF9C9EA7" FontSize="9" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#FFFFB74D" Margin="0,0,7,0"/>
          <TextBlock x:Name="ConnectionText" Text="STARTING" Foreground="#FFFFB74D" FontSize="11" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="0,20,0,14" Background="#FF241B22" BorderBrush="#FF4A202B" BorderThickness="1" CornerRadius="11" Padding="15,12">
        <DockPanel>
          <StackPanel>
            <TextBlock Text="CURRENT SESSION" Foreground="#FF9C9EA7" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" Text="Waiting for telemetry..." Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ModeText" DockPanel.Dock="Right" VerticalAlignment="Center" Text="OFFLINE ENGINEER" TextAlignment="Right" Foreground="#FFD4D5DA" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
          <Border Background="#FF1B1D25" CornerRadius="9" Padding="12,10" Margin="0,0,7,0">
            <StackPanel><TextBlock Text="SPEED" Foreground="#FF9699A4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SpeedText" Style="{StaticResource CardText}" Text="—"/><TextBlock Text="km/h" Foreground="#FF777A85" FontSize="10"/></StackPanel>
          </Border>
          <Border Background="#FF1B1D25" CornerRadius="9" Padding="12,10" Margin="3,0,4,0">
            <StackPanel><TextBlock Text="FUEL" Foreground="#FF9699A4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FuelText" Style="{StaticResource CardText}" Text="—"/><TextBlock Text="litres" Foreground="#FF777A85" FontSize="10"/></StackPanel>
          </Border>
          <Border Background="#FF1B1D25" CornerRadius="9" Padding="12,10" Margin="4,0,3,0">
            <StackPanel><TextBlock Text="TYRES" Foreground="#FF9699A4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TyreText" Style="{StaticResource CardText}" Text="—"/><TextBlock Text="°C" Foreground="#FF777A85" FontSize="10"/></StackPanel>
          </Border>
          <Border Background="#FF1B1D25" CornerRadius="9" Padding="12,10" Margin="7,0,0,0">
            <StackPanel><TextBlock Text="LAP" Foreground="#FF9699A4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LapText" Style="{StaticResource CardText}" Text="—"/><TextBlock x:Name="ProgressText" Text="—" Foreground="#FF777A85" FontSize="10"/></StackPanel>
          </Border>
        </UniformGrid>
        <Border Grid.Row="1" Background="#FF2A171D" BorderBrush="#FF8E2938" BorderThickness="1" CornerRadius="12" Padding="17,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#FFE52B3A" CornerRadius="7" Width="34" Height="34" VerticalAlignment="Top">
              <TextBlock Text="AI" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0">
              <TextBlock Text="ENGINEER MESSAGE" Foreground="#FFFF8290" FontSize="10" FontWeight="Bold"/>
              <TextBlock x:Name="EngineerText" Margin="0,6,0,0" Foreground="#FFF8F8FA" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Text="Engineer: all clear."/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <DockPanel Grid.Row="3" Margin="0,17,0,0">
        <TextBlock x:Name="TransportText" Foreground="#FF8F929D" FontSize="10" VerticalAlignment="Center" Text="Listening for ACC telemetry"/>
        <Button DockPanel.Dock="Right" Content="Close" Click="CloseClick"/>
        <Button DockPanel.Dock="Right" Content="Settings" Click="SettingsClick"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
